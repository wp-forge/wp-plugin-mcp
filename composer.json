{
  "name": "wp-forge/wp-plugin-mcp",
  "description": "A friendly WordPress MCP plugin exposing wp-forge tools.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "autoload": {
    "psr-4": {
      "WP_Forge\\": "src/"
    }
  },
  "scripts": {
    "test": "php tests/run.php"
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "allow-plugins": {
      "automattic/jetpack-autoloader": true
    }
  },
  "require": {
    "php": ">=8.2",
    "wordpress/mcp-adapter": "^0.6.1",
    "silverassist/wp-github-updater": "^1.3"
  }
}
